# ---- Database / auth (Supabase) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Brevo Emailing Service (https://www.brevo.com) ----
# Primary: Brevo API Key (Recommended - fast, zero port restrictions, high inbox rate)
BREVO_API_KEY=your-brevo-v3-api-key
VITE_BREVO_API_KEY=your-brevo-v3-api-key
BREVO_SENDER_NAME=MS ENTERPRISES
BREVO_SENDER_EMAIL=mohammedafiz447@gmail.com

# Optional: Brevo SMTP Relay (smtp-relay.brevo.com:587)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=mohammedafiz447@gmail.com

# ---- Online payments (optional). Leave empty to offer Cash on Delivery only ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Google sign-in (optional) ----
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_AUTH_PROXY=
